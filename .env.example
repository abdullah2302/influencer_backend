# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string (Atlas ya local)
MONGO_URI=mongodb://127.0.0.1:27017/influencer_platform

# Frontend ka URL (CORS ke liye)
CLIENT_URL=http://localhost:3000

# Platform ka naam (abhi final nahi)
PLATFORM_NAME=Influence Platform

# JWT secrets: lambi random strings. Banane ke liye:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Email (password reset ka OTP). Khali ho to development mein OTP terminal pe print hota hai.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=aap ka gmail,
# SMTP_PASS=Google "App Password" (asal Gmail password nahi)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Bhejne wale ka naam aur email, jaise: Influence Platform Support <support@example.com>
MAIL_FROM=

# "Sign in / Sign up with Google": Google Cloud Console -> APIs & Services -> Credentials ->
# OAuth client ID (Web application). Authorized JavaScript origins mein frontend ka domain daalein.
# Ye client ID public hai (secret nahi). Khali ho to Google wala button nahi dikhta
GOOGLE_CLIENT_ID=
